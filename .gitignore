# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Signing secrets (never commit)
credentials.json

# IDE state
.openidea/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# SQLite transient sidecars (regenerated automatically alongside *.db)
*.db-shm
*.db-wal

# Content tooling: local-only state (see docs/CONTENT_SQLITE_AND_STUDIO_SPEC.md)
content/backups/
content/database/studio-history.db
content/database/.studio.lock
content/database/*.bak-*
.opencode/studio-token

# Unused remainder of the licensed SFX library (see docs/SFX_SPEC.md §3, §4.2)
assets/sfx/kent-sfx/

# Local tooling and private skills: never committed
.claude/
.opencode/
.vscode/
