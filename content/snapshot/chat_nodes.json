    {
      "id": "chat-hal-banana-k",
      "npc_id": "npc-hal",
      "kind": "reply",
      "trigger": null,
      "title": null,
      "text": "A banana holds potassium, and a tiny part of all potassium is a radioactive isotope called potassium-40.\n\nIt is in bananas, in nuts, in the soil, and in you.",
      "pose": "explain",
      "replies": [
        {
          "label": "In me?",
          "next": "chat-hal-banana-me"
        },
        {
          "label": "Is it safe?",
          "next": "chat-hal-banana-safe"
        },
        {
          "label": "Open half-life in AtomDex",
          "action": {
            "screen": "entry",
            "id": "half-life"
          }
        }
      ],
      "position": 11
    },
    {
      "id": "chat-hal-banana-me",
      "npc_id": "npc-hal",
      "kind": "reply",
      "trigger": null,
      "title": null,
      "text": "Yes. Every person carries some potassium-40, and a few of its atoms decay every second.\n\nIt decays very slowly. Its half-life is more than a billion years, which is why it is still around.",
      "pose": "proud",
      "replies": [
        {
          "label": "mind-blown",
          "type": "emoji",
          "next": "chat-hal-banana-end"
        },
        {
          "label": "banana",
          "type": "emoji"
        }
      ],
      "position": 13
    },
    {
      "id": "chat-hal-banana-safe",
      "npc_id": "npc-hal",
      "kind": "reply",
      "trigger": null,
      "title": null,
      "text": "Completely safe. The amount is far too small to matter.\n\nYour own body holds the same kind of atom, and you are fine.\n\nEating bananas is good for you.",
      "pose": "explain",
      "replies": [
        {
          "label": "In me?",
          "next": "chat-hal-banana-me"
        },
        {
          "label": "Thanks, Hal",
          "next": "chat-hal-banana-end"
        }
      ],
      "position": 12
