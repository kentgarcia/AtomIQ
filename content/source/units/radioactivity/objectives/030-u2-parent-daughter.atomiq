references: ref-openstax-chem-21-3

prompt:
    The parent decays, and the nucleus it becomes is the ___.

mode: bank

bank:
    {"id":"daughter","label":"daughter"}
    {"id":"parent","label":"parent"}
    {"id":"stable","label":"stable one"}

answer: daughter

explanation:
    The nucleus that decays is the parent, and the nucleus it becomes is the daughter.
