tags: hard

sources:
    {"title":"Sources and Effects of Ionizing Radiation","url":"https://www.unscear.org/unscear/en/publications.html","author":"UNSCEAR","type":"official"}
    {"title":"Radiation in Everyday Life","url":"https://www.iaea.org/topics/radiation-in-everyday-life","author":"IAEA","type":"official"}
