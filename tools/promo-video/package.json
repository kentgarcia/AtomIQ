{
  "name": "atomiq-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "AtomIQ 30s 16:9 Duolingo-style launch promo video built with Remotion 4 + Cinetic discipline.",
  "scripts": {
    "prepare-assets": "node --no-warnings scripts/prepare-assets.mjs",
    "gen-music": "python3 scripts/gen-music.py",
    "mix-audio": "node --no-warnings scripts/mix-audio.mjs",
    "audio": "npm run gen-music && npm run mix-audio",
    "copy-check": "node --no-warnings scripts/copy-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run copy-check",
    "studio": "remotion studio",
    "contact-sheet": "node --no-warnings scripts/contact-sheet.mjs",
    "render": "node --no-warnings scripts/render-master.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
