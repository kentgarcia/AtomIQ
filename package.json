{
  "name": "atomiq",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/sync-content.js && expo start",
    "android": "node scripts/sync-content.js && expo start --android",
    "ios": "node scripts/sync-content.js && expo start --ios",
    "web": "node scripts/sync-content.js && expo start --web",
    "lint": "expo lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "sync-content": "node scripts/sync-content.js",
    "postinstall": "node scripts/sync-content.js",
    "content-editor": "node scripts/content-editor.js",
    "content-studio": "node tools/studio/server.mjs",
    "eas:preview:android": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "iconsax-react-native": "^0.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
