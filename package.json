{
  "name": "atomiq",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/sync-content.js && expo start",
    "android": "node scripts/sync-content.js && expo start --android",
    "ios": "node scripts/sync-content.js && expo start --ios",
    "web": "node scripts/sync-content.js && expo start --web",
    "lint": "expo lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "sync-content": "node scripts/sync-content.js",
    "postinstall": "node scripts/sync-content.js",
    "content-editor": "node scripts/content-editor.js",
    "content-studio": "node tools/studio/server.mjs",
    "eas:preview:android": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.23",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "iconsax-react-native": "^0.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
